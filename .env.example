# Copie para .env:  cp .env.example .env
#
# NADA aqui vai para o repositorio: o .env esta no .gitignore. Toda a
# configuracao da plataforma entra por variavel de ambiente - o container
# precisa ser portatil (item 2 do roteiro do edital).

# ---------- autenticacao (TAREFA 1) ----------
# Em producao (AMBIENTE=producao) o gateway RECUSA subir com o valor de exemplo.
# Gere um segredo de verdade:  openssl rand -hex 32
JWT_SEGREDO=troque-este-segredo
JWT_VALIDADE_SEGUNDOS=3600

API_USUARIO=aluno
# Hash da senha (recomendado). Gere com:
#   python -m gateway.autenticacao "sua-senha"
API_SENHA_HASH=
# Senha em claro - APENAS para desenvolvimento local. Se API_SENHA_HASH estiver
# preenchida, esta e ignorada.
API_SENHA=troque-esta-senha

# ---------- limite de uso (TAREFA 2) ----------
LIMITE_POR_MINUTO=30
LIMITE_LOGIN_POR_MINUTO=5

# ---------- LLM (a carga de trabalho) ----------
# Vazia = MODO SIMULADO: a plataforma funciona offline, sem chamar ninguem.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODELO=gpt-4o-mini
LLM_TIMEOUT=20
TENTATIVAS_LLM=3

# ---------- rastreamento (TAREFA 7) ----------
# Vazio = spans criados mas nao exportados (a plataforma sobe sem coletor).
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# ---------- ambiente ----------
AMBIENTE=local
LOG_NIVEL=INFO

# Interface em que o compose publica as portas. 127.0.0.1 significa "so o
# proprio servidor enxerga" - quem atravessa a borda e o nginx com HTTPS.
# NUNCA use 0.0.0.0 num servidor: o Docker passa por cima do UFW.
BIND_LOCAL=127.0.0.1

# Portas publicadas no host. Configuraveis para a stack poder subir duas vezes
# na mesma maquina - por exemplo, validar um clone limpo sem derrubar o que ja
# esta no ar.
PORTA_GATEWAY=8000
PORTA_JAEGER=16686
